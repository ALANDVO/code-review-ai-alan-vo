# Environment mode: development | test | production
ENV=development

# Local Demo Mode: true allows local demo access without external Keycloak (refused if ENV=production)
DEMO_MODE=true

# Host & Port bindings (development binds to 127.0.0.1)
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/code_review.db

# LLM Configuration (LLM_API_KEY is the only secret credential)
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Keycloak OIDC Configuration (production auth)
OIDC_ISSUER=http://127.0.0.1:8080/realms/code-review-realm
OIDC_AUDIENCE=code-review-client
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/code-review-realm/protocol/openid-connect/certs

# Frontend Environment
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_KEYCLOAK_URL=http://127.0.0.1:8080
VITE_KEYCLOAK_REALM=code-review-realm
VITE_KEYCLOAK_CLIENT_ID=code-review-client
